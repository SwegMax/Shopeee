# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex
*.class

# Generated files
/build/
/out/
/gen/

# Local configuration file (sdk path, etc)
local.properties

# Gradle files
.gradle/

# IntelliJ / Android Studio files
.idea/
*.iml
*.iws
*.ipr
# Specific .idea files to *not* ignore (if you want to share common IDE settings)
!.idea/encodings.xml
!.idea/vcs.xml
!.idea/gradle.xml
!.idea/libraries/ # Often, you want to commit these if they are generated by Gradle for IDE sync

# Keystore files (for signing your app - keep these private and secure!)
*.jks
*.keystore

# Log files
*.log
*.log.gz

# OS-specific files
.DS_Store # macOS
Thumbs.db # Windows

# Android Studio captures folder
captures/

# Any custom files you want to ignore (e.g., sensitive config files not handled by build process)
# my_api_keys.properties